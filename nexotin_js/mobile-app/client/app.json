{
  "expo": {
    "scheme": "nexotin-app-scheme",
    "deepLinking": true,
    "name": "Nexotin",
    "slug": "client",
    "version": "1.5.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1E88E5"
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      "expo-font",
      "expo-router"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "128",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "nexotin-app-scheme"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "nexotin-app-scheme"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.yevsel.client",
      "associatedDomains": [
        "applinks:nexotin.com",
        "applinks:www.nexotin.com",
        "applinks:nexotin.com",
        "applinks:www.nexotin.com"
      ]
    },
    "android": {
      "minSdkVersion": 21,
      "targetSdkVersion": 35,
      "googleServicesFile": "google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#fff",
        "versionCode": "72"
      },
      "package": "com.yevsel.client",
      "versionCode": 103,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "nexotin-app-scheme",
              "host": "*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "nexotin.com",
              "pathPrefix": "/vendorProfile"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "nexotin.com",
              "pathPrefix": "/shop/products"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "nexotin.com",
              "path": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "1ab7aaff-5e04-48b5-84b6-afbb2cbf7300"
      }
    },
    "owner": "yevsel"
  }
}
