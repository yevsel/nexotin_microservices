# Copy to .env: cp .env.example .env

# Host ports (change these if something else is already using them)
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
ADMINER_PORT=8081
REDIS_INSIGHT_PORT=5540
FLOWER_PORT=5555

# Local PostgreSQL database
POSTGRES_USER=nexotin
# Keep this URL-safe because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=nexotin_dev_password
POSTGRES_DB=nexotin

# Local RabbitMQ broker
RABBITMQ_USER=nexotin
# Keep this URL-safe because it is embedded in CELERY_BROKER_URL.
RABBITMQ_PASSWORD=nexotin_rabbit_password

# Import targets inside the containers
UVICORN_APP=app.main:app
CELERY_APP=app.celery_app:celery_app

# App secrets (fill in what your FastAPI port needs)
# LOGIN_SECRET=
# LOGIN_USER_SECRET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Gmail account used to send vendor welcome emails
# GMAIL_USER=nexotincom@gmail.com
# GMAIL_PASSWORD=
# YEVSEL_TWILLIO_SID=
# YEVSEL_TWILLIO_AUTH_TOKEN=
